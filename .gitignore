# --- Secrets (anayasa §2.2, §15) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials*.json

# --- WordPress çekirdek yapılandırma (makineye özel, secret içerir) ---
wp-config.php
wp-config-*.php

# --- Uploads / cache ---
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-content/advanced-cache.php
wp-content/object-cache.php
cache/
.cache/

# --- Yedekler ve üretim DB dökümleri (anayasa §8.3: siteden ayrı konumda) ---
*.sql
*.sql.gz
*.dump
*.bak
*.backup
# Dispatch kanıt yedekleri: İÇERİK dosyaları (php/css) repo DIŞI kalır; SHA256SUMS kayıtları takip edilir (PACK-88)
backups/
!dispatch/out/backups/
dispatch/out/backups/**/*.php
dispatch/out/backups/**/*.css

# --- Node / PHP bağımlılıkları ---
node_modules/
vendor/

# --- Dispatch: çalışma logları ignore, report'lar (out-*.md) KANIT olarak takip edilir ---
dispatch/run-*.log
.hermes/dispatch/tmp*

# --- OS / editör artıkları ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- P57 araştırma/kazıma dizinleri repoya girmesin ---
.p57-woo-src/

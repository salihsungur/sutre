# .env.example — LOCAL compose iskeleti için PLACEHOLDER değerler
#
# DURUM: ADR-001 KARAR BEKLEMEDE (TASLAK / OWNER_APPROVAL_REQUIRED) — anayasa §0.2.
#
# KULLANIM: `cp .env.example .env` sonrası .env içindeki değerleri kendin belirle.
# BU DOSYA GERÇEK SECRET İÇERMEZ ve İÇERMEMELİDİR (anayasa §4.2, §2.2).
# .env dosyası Git DIŞIDIR (kök .gitignore: .env.*); yalnız bu .env.example takip edilir.
# Gerçek PayTR merchant ID/key/salt bu dosyalara ASLA yazılmaz (anayasa §15).

# --- Ortam ---
# WP_ENV: local | staging | production — ödeme adapter'ı buna göre secret seti seçer (environment-plan §2).
WP_ENV=local

# --- MariaDB ---
# Yalnız local geliştirme; değerler placeholder'dır. .env'e yazacağın değerleri
# güçlü ve benzersiz yap; bu dosyadakileri asla başka ortama kopyalama.
MYSQL_DATABASE=brand_local
MYSQL_USER=brand_local_user
MYSQL_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_LOCAL_DB_ROOT_PASSWORD

# --- WordPress ---
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_LOCALE=tr_TR

# --- Saat dilimi ---
TZ=Europe/Istanbul
